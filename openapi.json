{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Extractor API",
    "summary": "Extrae datos de facturas de cualquier país con IA y los exporta a Excel y PDF.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Comprobación de salud",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Límites, formatos aceptados, proveedores e idiomas de exportación",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/validate": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Revalida una factura editada (no llama a la IA)",
        "operationId": "validate_api_v1_invoices_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentType": {
        "type": "string",
        "enum": [
          "invoice",
          "receipt",
          "credit_note",
          "other"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "TOO_MANY_FILES",
          "NO_FILES",
          "TOO_MANY_INVOICES",
          "VALIDATION_ERROR",
          "PROVIDER_NOT_AVAILABLE",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "RATE_LIMITED",
          "LLM_QUOTA_EXCEEDED",
          "LLM_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "description": "Códigos de error HTTP del contrato (sección 5)."
      },
      "ExportLanguage": {
        "type": "string",
        "enum": [
          "es",
          "en"
        ]
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "Invoice": {
        "properties": {
          "document_type": {
            "$ref": "#/components/schemas/DocumentType",
            "default": "invoice"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "issue_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Date",
            "description": "Obligatorio (validación)."
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10,
                "minLength": 1,
                "description": "ISO 4217 (p. ej. `MXN`). Si no es válido, la validación lo marca."
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency",
            "description": "Obligatorio (validación)."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 3166-1 alfa-2 (p. ej. `MX`)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 639-1 (p. ej. `es`)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "issuer": {
            "$ref": "#/components/schemas/Party"
          },
          "recipient": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Party"
              },
              {
                "type": "null"
              }
            ]
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "title": "Line Items"
          },
          "subtotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtotal"
          },
          "discount_total": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount Total"
          },
          "taxes": {
            "items": {
              "$ref": "#/components/schemas/Tax"
            },
            "type": "array",
            "title": "Taxes"
          },
          "total": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Total",
            "description": "Obligatorio (validación)."
          },
          "payment_method": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "title": "Invoice"
      },
      "Issue": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/IssueCode"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Ruta del campo, p. ej. `total` o `line_items.0.amount`."
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "code",
          "severity"
        ],
        "title": "Issue"
      },
      "IssueCode": {
        "type": "string",
        "enum": [
          "MISSING_REQUIRED_FIELD",
          "INVALID_CURRENCY",
          "TOTAL_MISMATCH",
          "SUBTOTAL_MISMATCH",
          "LINE_AMOUNT_MISMATCH",
          "TAX_MISMATCH",
          "DUE_BEFORE_ISSUE",
          "FUTURE_DATE",
          "LOW_CONFIDENCE"
        ],
        "title": "IssueCode"
      },
      "LLMProvider": {
        "type": "string",
        "enum": [
          "gemini",
          "ollama",
          "fake"
        ]
      },
      "Limits": {
        "properties": {
          "max_files_per_request": {
            "type": "integer",
            "title": "Max Files Per Request"
          },
          "max_file_size_mb": {
            "type": "integer",
            "title": "Max File Size Mb"
          },
          "max_pdf_pages": {
            "type": "integer",
            "title": "Max Pdf Pages"
          },
          "max_invoices_per_export": {
            "type": "integer",
            "title": "Max Invoices Per Export"
          }
        },
        "type": "object",
        "required": [
          "max_files_per_request",
          "max_file_size_mb",
          "max_pdf_pages",
          "max_invoices_per_export"
        ],
        "title": "Limits"
      },
      "LineItem": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "quantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price"
          },
          "discount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount"
          },
          "tax_rate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Rate",
            "description": "Porcentaje (`16` = 16 %)."
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
            "title": "Amount",
            "description": "cantidad * precio unitario - descuento",
            "examples": [
              "1234.50"
            ]
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "LineItem"
      },
      "MetaResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "accepted_mime_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Mime Types"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderInfo"
            },
            "type": "array",
            "title": "Providers"
          },
          "export_languages": {
            "items": {
              "$ref": "#/components/schemas/ExportLanguage"
            },
            "type": "array",
            "title": "Export Languages"
          }
        },
        "type": "object",
        "required": [
          "version",
          "limits",
          "accepted_mime_types",
          "providers",
          "export_languages"
        ],
        "title": "MetaResponse"
      },
      "Party": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "tax_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Id"
          },
          "tax_id_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Id Type",
            "description": "Texto libre: RFC, NIF, CUIT, VAT, EIN..."
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "type": "object",
        "title": "Party",
        "description": "Emisor o receptor. En el emisor, `name` es obligatorio (lo comprueba la validación)."
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank",
            "examples": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "examples": [
              "Unprocessable Content"
            ]
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "examples": [
              422
            ]
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "examples": [
              "Max 10 files per request"
            ]
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "examples": [
              {
                "max_files": 10
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "description": "Cuerpo de error RFC 9457 extendido con `code` y `params`."
      },
      "ProviderInfo": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/LLMProvider"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "default": {
            "type": "boolean",
            "title": "Default"
          }
        },
        "type": "object",
        "required": [
          "id",
          "available",
          "default"
        ],
        "title": "ProviderInfo"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "error",
          "warning",
          "info"
        ]
      },
      "Tax": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "rate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Porcentaje (`16` = 16 %)."
          },
          "base": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Base"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
            "title": "Amount",
            "examples": [
              "1234.50"
            ]
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "Tax"
      },
      "ValidateRequest": {
        "properties": {
          "invoice": {
            "$ref": "#/components/schemas/Invoice"
          }
        },
        "type": "object",
        "required": [
          "invoice"
        ],
        "title": "ValidateRequest"
      },
      "ValidateResponse": {
        "properties": {
          "validation": {
            "$ref": "#/components/schemas/Validation"
          }
        },
        "type": "object",
        "required": [
          "validation"
        ],
        "title": "ValidateResponse"
      },
      "Validation": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ValidationStatus"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Validation"
      },
      "ValidationStatus": {
        "type": "string",
        "enum": [
          "valid",
          "warnings",
          "invalid"
        ]
      }
    }
  }
}
