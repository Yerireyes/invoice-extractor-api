{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "invoice-extractor-api",
      "release-as": "1.0.0",
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore${scope}: publicar versión ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": "openapi.json",
          "jsonpath": "$.info.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='invoice-extractor-api')].version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Nuevas funcionalidades" },
        { "type": "fix", "section": "Correcciones" },
        { "type": "perf", "section": "Rendimiento" },
        { "type": "refactor", "section": "Refactorizaciones", "hidden": true },
        { "type": "chore", "section": "Mantenimiento", "hidden": true },
        { "type": "docs", "section": "Documentación", "hidden": true }
      ]
    }
  }
}
