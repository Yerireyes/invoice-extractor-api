# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.

# development | production
APP_ENV=development
# En Render lo fija la plataforma (variable PORT)
PORT=8000
LOG_LEVEL=INFO

# gemini | ollama | fake  (en development, sin GEMINI_API_KEY o GEMINI_MODEL se usa `fake`)
LLM_PROVIDER=gemini
# Secreto: obtenlo en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo Flash con visión del nivel gratuito. Recomendado (2026-11): gemini-3.5-flash-lite
# (nivel gratuito: 15 RPM, 500 RPD; gemini-3.8-flash solo 5 RPM, 20 RPD y suele saturarse).
# Límites vigentes: https://aistudio.google.com/rate-limit · Modelos: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Timeout por llamada, en segundos (se reintenta una vez si el error es transitorio)
GEMINI_TIMEOUT_S=60

# Modo privado: las facturas se procesan con un modelo local y no salen de tu máquina.
# Con `docker compose --profile ollama up` el modelo se descarga solo la primera vez.
OLLAMA_ENABLED=false
# Dentro de docker compose: http://ollama:11434 · Ollama instalado en el equipo: http://localhost:11434
# (o http://host.docker.internal:11434 si la API corre en Docker y Ollama fuera)
OLLAMA_BASE_URL=http://ollama:11434
# Modelo de visión (https://ollama.com/library/qwen3-vl). En equipos modestos: qwen3-vl:4b
OLLAMA_MODEL=qwen3-vl:8b
# Timeout por documento, en segundos (en CPU un modelo local puede tardar minutos)
OLLAMA_TIMEOUT_S=300

# Orígenes permitidos para CORS, separados por comas
ALLOWED_ORIGINS=http://localhost:5173
# Peticiones a /invoices/extract por IP (sintaxis: 10/minute, 100/hour...)
RATE_LIMIT_EXTRACT=10/minute
# Documentos enviados a Gemini por día, reinicio a medianoche del Pacífico (0 = sin tope).
# El nivel gratuito permite 500 peticiones/día: 450 deja margen para reintentos.
DAILY_DOCUMENT_LIMIT=450
