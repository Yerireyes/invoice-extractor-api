# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.

# development | production
APP_ENV=development
# En Hugging Face Spaces: 7860
PORT=8000
LOG_LEVEL=INFO

# gemini | ollama | fake  (en development, sin GEMINI_API_KEY se usa `fake`)
LLM_PROVIDER=gemini
# Secreto: obtenlo en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo Flash con visión vigente en el nivel gratuito
GEMINI_MODEL=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5vl

# Orígenes permitidos para CORS, separados por comas
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_EXTRACT=10/minute
